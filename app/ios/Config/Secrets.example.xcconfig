// Copy this file to Secrets.xcconfig (git-ignored) and fill in what you have. Never commit secrets.

// Your Apple Developer Team ID, so Xcode can sign the app for your iPhone.
DEVELOPMENT_TEAM =

// Optional: free OpenSky API client (opensky-network.org > Account > API client).
OPENSKY_CLIENT_ID =
OPENSKY_CLIENT_SECRET =

// Only for release-channel builds; leave as 0 for Developer Mode.
META_APP_ID = 0
CLIENT_TOKEN = 0
